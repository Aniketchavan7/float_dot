{
  "name": "float-dot",
  "version": "0.1.0",
  "private": true,
  "description": "A local screen and voice assistant for coding practice and debugging",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:fixtures": "node scripts/fixture-runner.cjs",
    "test:soak": "node scripts/soak-test.cjs",
    "test:audio": "node scripts/test-mic.cjs",
    "test:eval": "node scripts/run-eval.cjs",
    "smoke": "node scripts/start.cjs --smoke",
    "setup:local": "node scripts/setup-local.cjs",
    "check:local": "node scripts/check-local.cjs",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win nsis portable",
    "setup:search": "node scripts/setup-search.cjs",
    "release:checksums": "node scripts/release-checksums.cjs"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "prismjs": "1.30.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.floatdot.desktop",
    "productName": "Float Dot",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "PROVENANCE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": ".models",
        "to": "models",
        "filter": [
          "eng.traineddata",
          "ggml-base.bin",
          "*-LICENSE.txt",
          "whisper/**/whisper-cli.exe",
          "whisper/**/*.dll"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    }
  }
}
